{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023"], "types": ["node"],
    "strict": true, "noEmit": true, "skipLibCheck": true, "allowImportingTsExtensions": true, "isolatedModules": true,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src", "test"]
}
